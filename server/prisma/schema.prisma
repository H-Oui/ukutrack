generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
   id        String   @id @default(cuid())
  email      String   @unique
  password   String
  username   String
  niveau     String   @default("débutant")
  createdAt  DateTime @default(now())

  songs            Song[]
  userChords       UserChord[]
  practiceSessions PracticeSession[]
}

model Song {
  id                String   @id @default(cuid())
  titre             String
  artiste           String
  youtubeUrl        String
  youtubeThumbnail  String
  statut            String   @default("à apprendre")

  commentaire       String?

  userId            String
  user              User @relation(fields: [userId], references: [id])

  songChords        SongChord[]
}

model Chord {
  id            String   @id @default(cuid())

  nom           String
  symbole       String?  // C, Am, F#m7...
  tonalite      String?  // C, D, E...
  type          String?  // majeur, mineur, 7, maj7...

  difficulte    String   @default("facile")

  diagrammeUrl  String?
  youtubeUrl    String?

  description   String?

  tags          String? // "pop,rock,jazz"

  createdAt     DateTime @default(now())

  userChords UserChord[]
  songChords SongChord[]
}

model UserChord {
  id        String   @id @default(cuid())
  userId    String
  chordId   String
  statut    String   @default("en apprentissage")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chord Chord @relation(fields: [chordId], references: [id], onDelete: Cascade)
}

model SongChord {
  id       String @id @default(cuid())

  songId   String
  chordId  String

  song     Song @relation(fields: [songId], references: [id])
  chord    Chord @relation(fields: [chordId], references: [id])
}
model PracticeSession {
  id            String   @id @default(cuid())
  userId        String
  dureeMinutes  Int
  notes         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}